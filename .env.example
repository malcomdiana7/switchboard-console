# ==============================================================================
# 基础配置
# ==============================================================================

# 后端 HTTP 服务监听端口。
PORT=3000

# PostgreSQL 连接串；保存全部业务状态、任务租约、事件 inbox/outbox 和登录会话。
DATABASE_URL=postgres://switchboard:switchboard@localhost:5432/switchboard

# 后端访问消息网关的基础地址；本地开发时指向仓库内的网关模拟器。
GATEWAY_URL=http://localhost:4100

# 后端访问 Agent 服务的基础地址；C 组关闭时使用该模拟 Agent。
AGENT_URL=http://localhost:4200

# Access Token 签名密钥；生产环境必须替换为至少 32 字节的随机值。
JWT_SECRET=change-me-to-at-least-32-characters

# 允许携带 Cookie 和 Authorization 请求后端的前端来源，用于 CORS 校验。
WEB_ORIGIN=http://localhost:5173

# 单次调用 Agent /agent/turn 的超时时间，单位毫秒；建议保持在 10000–15000。
TURN_TIMEOUT_MS=12000

# 本地网关模拟器监听端口，仅影响 @switchboard/mock-gateway。
GATEWAY_MOCK_PORT=4100

# 本地 Agent 模拟器监听端口，仅影响 @switchboard/mock-agent。
AGENT_MOCK_PORT=4200

# ==============================================================================
# 以下是 C 组功能配置
# ==============================================================================

# C 组总开关：true 同时启用 C1 媒体归档和 C2 真实 LLM Agent；false 使用基础功能。
ENABLE_C_FEATURES=false

# ------------------------------------------------------------------------------
# C1：媒体文件归档与清理
# ------------------------------------------------------------------------------

# 媒体文件保留天数；超过期限且未被运行中 Agent Run 使用的文件会被清理。
MEDIA_RETENTION_DAYS=30

# 媒体文件保存目录；相对路径以项目启动目录为基准。
MEDIA_DIR=media

# ------------------------------------------------------------------------------
# C2：OpenAI 兼容 LLM Agent
# ------------------------------------------------------------------------------

# C 组开启时，后端访问独立 LLM Agent 的地址。
LLM_AGENT_URL=http://localhost:4300

# OpenAI 兼容服务的 v1 基础地址，例如 https://api.openai.com/v1 或本地服务的 /v1 地址。
LLM_BASE_URL=https://api.openai.com/v1

# OpenAI 兼容服务的 API 密钥；本地免鉴权服务可留空。
LLM_API_KEY=

# OpenAI 兼容服务使用的模型名称。
LLM_MODEL=gpt-4.1-mini

# 独立 LLM Agent 的监听端口。
LLM_AGENT_PORT=4300

# C3 为 Playwright 测试资产，不需要运行时环境变量；通过 npm run test:e2e 执行。
